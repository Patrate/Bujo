# ==========================
# JetBrains Rider
# ==========================

# Settings & caches
.idea/
*.sln.iml          # project files created by Rider
*.dotSettings       # Rider settings
*.rssettings        # Rider solution settings (if any)

# Visual Studio / .NET build output
[Bb]in/             # compiled binaries
[Oo]bj/             # intermediate objects
.vs/                # VS 2015+ local configuration

# User-specific files
*.user              # user options
*.suo               # solution user options
*.cachefile         # cache files
*.pdb               # debug symbols
*.ipch              # IntelliSense database
*.log               # logs generated by build/run

# NuGet packages & related artefacts
packages/           # legacy package folder (for older projects)
project.lock.json   # lock file for NuGet 5.0+
.projectlock.json   # alternative lock format
*.nupkg             # pre‑built NuGet packages
*.snk               # strong‑name key files
*.pfx               # certificate files

# Rider specific artefacts (optional)
*.rider.*           # e.g., .rider.vcs, .rider.log

# ==========================
# End of file
